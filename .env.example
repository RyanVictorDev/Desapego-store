# PostgreSQL (Docker)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=desapegos

# Rails API
RAILS_ENV=production
RAILS_DISABLE_HOST_CHECK=1
SECRET_KEY_BASE=change_me_in_production
JWT_SECRET=change_me_in_production
DB_HOST=db
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=desapegos
SEED_DATABASE=true
CORS_ORIGINS=*

# Frontend (build Docker / Vite)
VITE_API_URL=/api/v1
